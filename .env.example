NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the app (1 on Railway/Render/Heroku-style hosts)
TRUST_PROXY=1

# MongoDB Atlas
# The database user needs the "readWriteAnyDatabase" role,
# because restaurant databases are created dynamically.
MONGODB_URI=
REGISTRY_DB_NAME=restaurant_registry
# Extra clusters later (clusterId = lowercase suffix), e.g.:
# MONGODB_URI__EU2=

# How long tenant routing (restaurantId -> database) stays cached, in ms
TENANT_CACHE_TTL_MS=30000

# Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PLATFORM_JWT_SECRET=
# 32 bytes base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Self sign-up: restaurants register at /admin/signup and get a free trial until you approve them.
# SELF_SIGNUP_ENABLED=true
# TRIAL_DAYS=7

# Super Admin two-step verification (TOTP). Default: required. "false" = email + password only.
# PLATFORM_MFA_REQUIRED=true

SUPER_ADMIN_EMAIL=ninja@mero.com
SUPER_ADMIN_PASSWORD=

# Image storage: set all three for Cloudinary. If empty: local disk in development,
# uploads disabled in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development only: folder for uploaded images when Cloudinary is not set
# LOCAL_MEDIA_DIR=.media

PUBLIC_MENU_URL=
# Used to build owner password-setup links, e.g. https://admin.yourdomain.com
DASHBOARD_URL=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=

# Refresh-token cookie Secure flag (default: true in production, false otherwise).
# Set to true in development only if you serve over https.
# COOKIE_SECURE=
